ADMIN_PORTAL_PASSWORD=replace-with-a-strong-private-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_PUBLIC_MEDIA_BUCKET=public-media

RESEND_API_KEY=re_replace_with_resend_api_key
LEAD_NOTIFY_EMAIL=armaandaswani@icloud.com
LEAD_FROM_EMAIL=Kombu <leads@your-verified-domain.com>

CRON_SECRET=replace-with-another-long-random-secret

# Kit pricing/creator orders: apply supabase/storefront.sql first.
INFINITEPAY_HANDLE=kombu-amazonia
